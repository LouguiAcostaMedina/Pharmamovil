CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    activo INTEGER NOT NULL DEFAULT 1,
    descripcion TEXT NOT NULL DEFAULT '',
    imagen TEXT NOT NULL DEFAULT '',
    categoria TEXT NOT NULL DEFAULT '',
    categoriaId INTEGER NOT NULL DEFAULT 1,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT,
    falloPermanente INTEGER NOT NULL DEFAULT 0,
    proximoReintentoEpochMillis INTEGER NOT NULL DEFAULT 0,
    claveIdempotencia TEXT
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1 ORDER BY id ASC;

listarPendientesParaSincronizacion:
SELECT * FROM producto
WHERE pendiente = 1
  AND falloPermanente = 0
  AND intentos < 5
  AND proximoReintentoEpochMillis <= :ahoraMillis
ORDER BY id ASC;

listarFallidas:
SELECT * FROM producto
WHERE pendiente = 1
  AND (falloPermanente = 1 OR intentos >= 5)
ORDER BY id ASC;

obtenerPorId:
SELECT * FROM producto WHERE id = ?;

insertar:
INSERT OR REPLACE INTO producto (
    id, nombre, precio, stock, activo, descripcion, imagen, categoria, categoriaId, pendiente,
    intentos, ultimoError, falloPermanente, proximoReintentoEpochMillis, claveIdempotencia
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

actualizar:
UPDATE producto
SET nombre = ?, precio = ?, stock = ?, activo = ?, descripcion = ?, imagen = ?, categoria = ?, categoriaId = ?, pendiente = ?,
    intentos = ?, ultimoError = ?, falloPermanente = ?, proximoReintentoEpochMillis = ?, claveIdempotencia = ?
WHERE id = ?;

borrarPorId:
DELETE FROM producto WHERE id = ?;

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;

confirmarSubida:
UPDATE producto
SET id = :idReal,
    nombre = :nombre,
    precio = :precio,
    stock = :stock,
    activo = :activo,
    descripcion = :descripcion,
    imagen = :imagen,
    categoria = :categoria,
    categoriaId = :categoriaId,
    pendiente = 0,
    intentos = 0,
    ultimoError = NULL,
    falloPermanente = 0,
    proximoReintentoEpochMillis = 0,
    claveIdempotencia = NULL
WHERE id = :idTemporal;

registrarFalloTransitorio:
UPDATE producto
SET intentos = intentos + 1,
    ultimoError = :ultimoError,
    proximoReintentoEpochMillis = :proximoReintentoEpochMillis
WHERE id = :id;

registrarFalloPermanente:
UPDATE producto
SET falloPermanente = 1,
    ultimoError = :ultimoError
WHERE id = :id;

rearmarReintentoManual:
UPDATE producto
SET falloPermanente = 0,
    intentos = 0,
    ultimoError = NULL,
    proximoReintentoEpochMillis = 0
WHERE id = :id;

actualizarClaveIdempotencia:
UPDATE producto
SET claveIdempotencia = :claveIdempotencia
WHERE id = :id;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND (falloPermanente = 1 OR intentos >= 5);
